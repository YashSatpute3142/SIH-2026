# Application
APP_NAME=mine-subsidence-system
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# MySQL - Local/Edge Database
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=mine_subsidence_system
DB_USER=root
DB_PASSWORD=

# MySQL - Cloud Database (used by sync layer in Chat 6)
CLOUD_DB_HOST=
CLOUD_DB_PORT=3306
CLOUD_DB_NAME=mine_subsidence_system_cloud
CLOUD_DB_USER=
CLOUD_DB_PASSWORD=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Simulator
SIMULATOR_NODE_COUNT=7
SIMULATOR_DEFAULT_INTERVAL_SECONDS=60
